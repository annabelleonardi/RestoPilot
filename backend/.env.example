# --- App ---
MOCK_MODE=true
DEFAULT_STORE_ID=1
# SQLite for the MVP; swap to postgresql+psycopg://user:pass@host/db for production.
DATABASE_URL=sqlite:///./restopilot.db

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_VERIFY_TOKEN=restopilot-dev-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Twilio (alternative WhatsApp provider) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- StepFun (perception layer: OCR + audio) ---
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1
